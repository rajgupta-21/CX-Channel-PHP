# Copy this file to `.env` and fill in your real values.
# DATABASE_URL format: mysql://USER:PASSWORD@HOST:PORT/DB_NAME
# For cPanel: host is usually 'localhost' (or the MySQL host shown in cPanel),
#          port is usually 3306, and the database name has your cPanel username prefix.

DATABASE_URL="mysql://cx_user:cx_pass@127.0.0.1:3307/cx_channel"

SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SENDER_EMAIL=you@yourdomain.com
SENDER_PASSWORD=your-smtp-password
TEAM_EMAIL=service@yourdomain.com
CC_EMAIL=service@yourdomain.com

# Optional: attach a logo to approval emails
# MAIL_IMAGE_PATH=/absolute/path/to/logo.png
# Show verbose errors only in debug
# APP_DEBUG=true