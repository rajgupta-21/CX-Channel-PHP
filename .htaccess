# Apache configuration for cPanel / shared hosting.
# Application is deployed under /CX-Channel-PHP

RewriteEngine On

# ---------------------------------------------------------------
# API, auth and upload routes
# ---------------------------------------------------------------
# These requests are handled by the PHP front controller.
#
# /CX-Channel-PHP/api/...
# /CX-Channel-PHP/auth/...
# /CX-Channel-PHP/uploads/...
#
# are internally routed to:
#
# server/index.php
# ---------------------------------------------------------------

RewriteRule ^(api|auth|uploads)(/.*)?$ server/index.php [L,QSA]


# ---------------------------------------------------------------
# Existing files and directories
# ---------------------------------------------------------------
# Let Apache serve files that actually exist.
# Examples:
#
# index.html
# login.html
# script.js
# style.css
# uploads/...
#
# ---------------------------------------------------------------

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# ---------------------------------------------------------------
# Everything else
# ---------------------------------------------------------------
# Send unknown frontend routes to landing.html
# ---------------------------------------------------------------

RewriteRule ^ landing.html [L]