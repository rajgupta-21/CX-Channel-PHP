# Apache configuration for cPanel / shared hosting.
# Mirrors the PHP built-in server router (router.php) for Apache.
# If your docroot is a subfolder (e.g. /public_html/CX-Channel-PHP),
# add:  RewriteBase /CX-Channel-PHP

RewriteEngine On

# Route API, uploads, and auth requests to the front controller.
RewriteCond %{REQUEST_URI} ^/(api|auth|uploads)/ [NC]
RewriteRule ^ server/index.php [L]

# Serve existing files/folders directly (HTML, CSS, JS, images).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else falls back to the landing page (matches router.php).
RewriteRule ^ landing.html [L]