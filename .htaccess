# Apache configuration for cPanel / shared hosting.
# Application is deployed under /CX-Channel-PHP

RewriteEngine On

# ---------------------------------------------------------------
# Serve uploaded files directly
# URL:
# /CX-Channel-PHP/uploads/file.jpg
#
# Physical:
# /CX-Channel-PHP/server/uploads/file.jpg
# ---------------------------------------------------------------
RewriteRule ^uploads/(.*)$ server/uploads/$1 [L]

# ---------------------------------------------------------------
# API routes
# ---------------------------------------------------------------
RewriteRule ^(api|auth)(/.*)?$ server/index.php [L,QSA]

# ---------------------------------------------------------------
# Existing files/directories
# ---------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------------
# Everything else -> landing page
# ---------------------------------------------------------------
RewriteRule ^ landing.html [L]