# Apache configuration for cPanel / shared hosting.

# Mirrors the PHP built-in server router (router.php) for Apache.
# Works in BOTH a subfolder (e.g. /public_html/CX-Channel-PHP) and the
# document root -- per-directory rules are matched relative to this file.

RewriteEngine On

# Never expose the error logs over HTTP
RewriteRule ^server/logs/ - [F,L]

# API, auth and upload routes go to the PHP front controller
RewriteRule ^(api|auth|uploads)(/.*)?$ server/index.php [L,QSA]

# Existing files and directories are served normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes to the landing page
RewriteRule ^ landing.html [L]